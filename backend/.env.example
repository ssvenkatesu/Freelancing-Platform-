# MongoDB Database Connection
MONGO_URI=mongodb://localhost:27017/freelancePlatform

# JWT Secret Key
JWT_KEY=your_jwt_secret_key_here

# Express Server Port
PORT=8800

# OpenRouter API Key (Optional - OpenAI compatible endpoint for any model)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Google Gemini API Key (Optional - Free tier available at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Python SBERT Microservice URL
SBERT_SERVICE_URL=http://localhost:8000

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
