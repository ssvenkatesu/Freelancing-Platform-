# ==========================================
# Environment Variables & Secret Credentials
# ==========================================
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
**/.env
**/.env.*
**/.env.local

# Preserve example and template env files
!.env.example
!**/.env.example
!.env.sample
!**/.env.sample
!.env.template
!**/.env.template

# Private keys and certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ==========================================
# Dependencies (Node.js & JavaScript)
# ==========================================
node_modules/
*/node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# ==========================================
# Build & Output Directories (Frontend & Vite)
# ==========================================
dist/
dist-ssr/
build/
out/
.vite/
*.local

# ==========================================
# Python & AI Service (FastAPI / SBERT)
# ==========================================
# Virtual environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/
**/venv/
**/.venv/

# Byte-compiled / cache files
__pycache__/
*/__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Large model artifacts & ML caches
*.bin
*.pt
*.pth
*.onnx
*.safetensors
*.h5
.cache/
**/.cache/

